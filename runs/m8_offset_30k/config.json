  "learning_rate": 0.001,
  "min_lr": 0.0001,
  "weight_decay": 0.1,
  "beta1": 0.9,
  "beta2": 0.99,
  "grad_clip": 1.0,
  "warmup_iters": 500,
  "max_iters": 30000,
  "eval_interval": 2000,
  "val_loss_batches": 20,
  "device": "cuda",
