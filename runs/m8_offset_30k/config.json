{
  "name": "m8_offset_30k",
  "out_root": "runs",
  "processed": "data/processed",
  "seed": 1,
  "block_size": 256,
  "batch_size": 64,
  "user_fraction": 1.0,
  "n_layer": 4,
  "n_head": 4,
  "n_embd": 128,
